#!/usr/bin/env bash
# Write ~/.config/lumynex/app.env from OpenBao and discovered host_vars.
# Secret values are not stored in this file.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${ROOT}/lib/openbao.sh"
openbao_load

prefix="secret/lumynex/app"
host_vars="${ROOT}/../inventory/host_vars"
dest="${HOME}/.config/lumynex/app.env"
names=(
  prhqv-cl1-app-n1
  prhqv-cl1-app-n2
  prhqv-cl1-app-n3
)

ip_of() {
  local file="${host_vars}/$1.yml"
  if [[ ! -f "${file}" ]]; then
    echo "missing ${file}" >&2
    return 1
  fi
  awk '/^ansible_host:/{print $2; exit}' "${file}"
}

field() {
  bao kv get -field="$1" "${prefix}/cl1/cluster"
}

mkdir -p "$(dirname "${dest}")"
tmp="$(mktemp "${dest}.XXXXXX")"
{
  printf 'DJANGO_SECRET_KEY=%q\n' "$(field django_secret_key)"
  printf 'DATABASE_HOST=%q\n' "$(field database_host)"
  printf 'DATABASE_PORT=%q\n' "$(field database_port)"
  printf 'DATABASE_NAME=%q\n' "$(field database_name)"
  printf 'DATABASE_USER=%q\n' "$(field database_user)"
  printf 'DATABASE_PASSWORD=%q\n' "$(field database_password)"
  for name in "${names[@]}"; do
    key="SYSMAINT_$(printf '%s' "${name}" | tr '-' '_')"
    value="$(bao kv get -field=sysmaint_password "${prefix}/${name}")"
    printf '%s=%q\n' "${key}" "${value}"
    printf '%s_HOST=%q\n' "${key}" "$(ip_of "${name}")"
  done
} >"${tmp}"
chmod 600 "${tmp}"
mv "${tmp}" "${dest}"
