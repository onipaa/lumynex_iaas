#!/usr/bin/env bash
# Write ~/.config/lumynex/loadbal-<pool>.env from OpenBao and discovered host_vars.
# Secret values are not stored in this file.
#
# Usage:
#   write-loadbal-env <app|pgdog>
#
# Exit codes: 0 = success, 2 = usage/error
#
# Requires: bash 3.2+, bao, ~/.config/lumynex/openbao.env
set -euo pipefail

readonly PROG="$(basename "$0")"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "${ROOT}/lib/openbao.sh"

die() {
  echo "error: $*" >&2
  exit 2
}

ip_of() {
  local file="${host_vars}/$1.yml"
  [[ -f "${file}" ]] || die "not found: ${file}"
  awk '/^ansible_host:/{print $2; exit}' "${file}"
}

[[ $# -eq 1 ]] || die "usage: ${PROG} <app|pgdog>"
pool="$1"
[[ "${pool}" == "app" || "${pool}" == "pgdog" ]] || die "usage: ${PROG} <app|pgdog>"

openbao_load
command -v bao >/dev/null 2>&1 || die "bao not found"

prefix="secret/lumynex/loadbal"
host_vars="${ROOT}/../inventory/host_vars"
dest="${HOME}/.config/lumynex/loadbal-${pool}.env"

if [[ "${pool}" == "app" ]]; then
  names=(prhqv-cl1-loadbal-n1 prhqv-cl1-loadbal-n2)
  backends=(prhqv-cl1-app-n1 prhqv-cl1-app-n2 prhqv-cl1-app-n3)
  vip="$(bao kv get -field=vip "${prefix}/cl1/app")"
else
  names=(prhqv-cl1-loadbal-n3 prhqv-cl1-loadbal-n4)
  backends=(prhqv-cl1-pgdog-n1 prhqv-cl1-pgdog-n2)
  vip="$(bao kv get -field=vip secret/lumynex/pgdog/cl1/cluster)"
fi

port="$(bao kv get -field=listen_port "${prefix}/cl1/${pool}")"
password="$(bao kv get -field=keepalived_password "${prefix}/cl1/${pool}")"
[[ -n "${vip}" ]] || die "client address is empty"

mkdir -p "$(dirname "${dest}")"
tmp="$(mktemp "${dest}.XXXXXX")"
{
  printf 'LOADBAL_POOL=%q\n' "${pool}"
  printf 'LOADBAL_VIP=%q\n' "${vip}"
  printf 'LOADBAL_PORT=%q\n' "${port}"
  printf 'KEEPALIVED_PASSWORD=%q\n' "${password}"
  for name in "${names[@]}"; do
    key="SYSMAINT_$(printf '%s' "${name}" | tr '-' '_')"
    value="$(bao kv get -field=sysmaint_password "${prefix}/${name}")"
    printf '%s=%q\n' "${key}" "${value}"
    printf '%s_HOST=%q\n' "${key}" "$(ip_of "${name}")"
  done
  for name in "${backends[@]}"; do
    key="BACKEND_$(printf '%s' "${name}" | tr '-' '_')"
    printf '%s_HOST=%q\n' "${key}" "$(ip_of "${name}")"
  done
} >"${tmp}"
chmod 600 "${tmp}"
mv "${tmp}" "${dest}"
