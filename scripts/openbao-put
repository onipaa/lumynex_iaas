#!/usr/bin/env bash
# Store fields in OpenBao. Values are arguments, never written into this file.
#   ./scripts/openbao-put secret/lumynex/postgresql/cl1/cluster postgres_password=... replicator_password=...
set -euo pipefail
if [[ $# -lt 2 ]]; then
  echo "usage: openbao-put <kv-path> key=value ..." >&2
  exit 64
fi
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/openbao.sh"
openbao_load
path="$1"
shift
if ! err="$(bao kv put "${path}" "$@" 2>&1)"; then
  rc=$?
  printf '%s\n' "${err}" | sed -E 's/=[^[:space:]]*/=REDACTED/g' >&2
  exit "${rc}"
fi
